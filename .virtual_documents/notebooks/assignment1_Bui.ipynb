def find_char(string, char):
    # Function to search a string and find occurences of a particular character
    # Input: String (str), character interested in searching (str)
    # Output: Number of occurences of a character
    occ = 0
    for chr in string: 
        if chr == char:
            occ += 1
        else: 
            occ = occ
    return occ





find_char("interesting", "i")
